# DriveSafe AI Environment Configuration Template
# Copy this file to .env and configure your secret keys

FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-drivesafe-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/drivesafe_ai?retryWrites=true&w=majority
